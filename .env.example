OPENAI_API_KEY=
PORT=3000

# Optional. Who chooses the tutor's words during a scripted lesson.
#   app    (default) the app decides each reply after you have spoken
#   server the voice model replies on its own, as it did before
# TUTOR_TURNS=app

# Optional. The model that writes each part of a lesson (default gpt-4.1).
# PLAN_MODEL=gpt-4.1

# Optional. How patient the tutor is about deciding you have finished speaking.
#   low   (default) a pause to think is not the end of your turn
#   auto  quicker to conclude you are done; try this if replies feel slow
# TURN_EAGERNESS=low

# Optional. Noise reduction on the microphone before the tutor listens for
# speech: near_field for a headset, far_field for a laptop or desk microphone.
# Worth trying if the tutor is cut off by sounds that are not you speaking.
# MIC_NOISE_REDUCTION=far_field
